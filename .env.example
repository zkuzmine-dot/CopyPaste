POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=copypaste
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

CLEANUP_INTERVAL_SECONDS=60

MESSAGE_TTL_SECONDS=60
CHANNEL_IDLE_TIMEOUT_SECONDS=300
WS_AUTH_TIMEOUT_SECONDS=5
CHANNEL_CLEANUP_INTERVAL_SECONDS=15
WS_MAX_MESSAGE_BYTES=1048576
WS_RATE_LIMIT_PER_SECOND=2
WS_RATE_LIMIT_BURST=10

FILES_DIR=/data/files
# Обязательно. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
FILES_SIGNING_SECRET=
FILE_MAX_SIZE_BYTES=52428800
NOTE_MAX_FILES=10
FILES_MAX_TOTAL_BYTES=5368709120
CHANNEL_FILE_TTL_SECONDS=300
BURN_NOTE_FILES_WINDOW_SECONDS=600
PENDING_UPLOAD_TTL_SECONDS=3600
FILE_URL_TTL_SECONDS=3600
UPLOAD_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_BURST=10
FILES_GC_INTERVAL_SECONDS=60
FILES_DISK_SWEEP_INTERVAL_SECONDS=3600

REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
NOTE_PASSWORD_MIN_LENGTH=4
NOTE_PASSWORD_MAX_LENGTH=128
KDF_TIME_COST=10
KDF_MEMORY_KIB=65536
KDF_PARALLELISM=4
KDF_MAX_CONCURRENT=4
UNLOCK_IP_MAX_FAILURES=10
UNLOCK_IP_WINDOW_SECONDS=900
UNLOCK_IP_BAN_SECONDS=900
UNLOCK_NOTE_MAX_FAILURES=5
UNLOCK_NOTE_WINDOW_SECONDS=60
UNLOCK_NOTE_LOCK_SECONDS=60
PROTECTED_FILE_URL_TTL_SECONDS=600
FILE_KEY_CACHE_SECONDS=600
FILE_ENCRYPTION_CHUNK_BYTES=65536
